<Project>
  <!-- See https://aka.ms/dotnet/msbuild/customize for more details on customizing your build -->
  <PropertyGroup>
    <Target-Framework-Version>net10.0</Target-Framework-Version>
    <Package-Version>10.1.4</Package-Version>
    <MongoDB-Driver>3.13.*</MongoDB-Driver>
    <Coverlet-Collector>10.1.*</Coverlet-Collector>
    <Microsoft-NET-Test-Sdk>18.11.*</Microsoft-NET-Test-Sdk>
    <Microsoft-Extensions-DependencyInjection>10.0.*</Microsoft-Extensions-DependencyInjection>
    <NUnit>5.0.*</NUnit>
    <NUnit-Analyzers>4.15.*</NUnit-Analyzers>
    <NUnit3TestAdapter>6.3.*</NUnit3TestAdapter>
  </PropertyGroup>
</Project>